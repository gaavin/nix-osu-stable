From f38d3c842e0991f85f81ac4c3e73361e4be9e163 Mon Sep 17 00:00:00 2001
From: Max Power <me@gavinpower.dev>
Date: Wed, 26 Aug 2026 20:11:29 -0230
Subject: [PATCH 1/3] ntdll: Inline-hook BASS_Init in osu!.exe to kill the 30ms
 device buffer.

---
 dlls/ntdll/Makefile.in  |   1 +
 dlls/ntdll/loader.c     |   6 +-
 dlls/ntdll/ntdll_misc.h |   1 +
 dlls/ntdll/osu_bass.c   | 384 ++++++++++++++++++++++++++++++++++++++++
 4 files changed, 391 insertions(+), 1 deletion(-)
 create mode 100644 dlls/ntdll/osu_bass.c

diff --git a/dlls/ntdll/Makefile.in b/dlls/ntdll/Makefile.in
index 0a419e3751..562592793b 100644
--- a/dlls/ntdll/Makefile.in
+++ b/dlls/ntdll/Makefile.in
@@ -29,6 +29,7 @@ SOURCES = \
 	locale.c \
 	math.c \
 	misc.c \
+	osu_bass.c \
 	path.c \
 	printf.c \
 	process.c \
diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index c0878f2efc..59f1819089 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -5078,6 +5078,10 @@ NTSTATUS WINAPI ApiSetQueryApiSetPresenceEx( const UNICODE_STRING *name, BOOLEAN
  */
 BOOL WINAPI DllMain( HINSTANCE inst, DWORD reason, LPVOID reserved )
 {
-    if (reason == DLL_PROCESS_ATTACH) LdrDisableThreadCalloutsForDll( inst );
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        LdrDisableThreadCalloutsForDll( inst );
+        osu_bass_init();
+    }
     return TRUE;
 }
diff --git a/dlls/ntdll/ntdll_misc.h b/dlls/ntdll/ntdll_misc.h
index 5cf6256641..1a29a037ea 100644
--- a/dlls/ntdll/ntdll_misc.h
+++ b/dlls/ntdll/ntdll_misc.h
@@ -80,6 +80,7 @@ extern LPCSTR debugstr_us( const UNICODE_STRING *str );
 extern void set_native_thread_name( DWORD tid, const char *name );
 
 /* init routines */
+extern void osu_bass_init(void);
 extern void loader_init( CONTEXT *context, void **entry );
 extern void version_init(void);
 extern void debug_init(void);
diff --git a/dlls/ntdll/osu_bass.c b/dlls/ntdll/osu_bass.c
new file mode 100644
index 0000000000..2e4e5a5821
--- /dev/null
+++ b/dlls/ntdll/osu_bass.c
@@ -0,0 +1,384 @@
+/*
+ * osu! BASS mixer hijack — ntdll PE side.
+ *
+ * osu!stable mixes through closed-source bass.dll. Default WASAPI
+ * BASS_CONFIG_DEV_BUFFER is 30 ms, which is most of the community −40 ms
+ * Offset. Game-dir replacement dies on updater integrity checks, so we
+ * inline-hook BASS after it is mapped, only in osu!.exe.
+ *
+ * Copyright 2026 nix-osu-stable
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <stdarg.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+
+#include "wine/debug.h"
+#include "ntdll_misc.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(osu_bass);
+
+#define ARRAY_LEN(x) (sizeof(x) / sizeof((x)[0]))
+
+#define BASS_CONFIG_UPDATEPERIOD  1
+#define BASS_CONFIG_DEV_BUFFER    27
+#define BASS_CONFIG_VISTA_TRUEPOS 30
+#define BASS_CONFIG_DEV_PERIOD    53
+
+#define BASS_DEVICE_LATENCY  0x100
+#define BASS_DEVICE_FREQ     0x4000
+#define BASS_DEVICE_DSOUND   0x40000
+
+#ifdef _WIN64
+#define JMP_LEN 12
+#else
+#define JMP_LEN 5
+#endif
+
+typedef BOOL (WINAPI *fn_BASS_Init)(int device, DWORD freq, DWORD flags, void *win, const void *clsid);
+typedef DWORD (WINAPI *fn_BASS_SetConfig)(DWORD option, DWORD value);
+
+static fn_BASS_Init orig_BASS_Init;
+static fn_BASS_SetConfig orig_BASS_SetConfig;
+static BOOL hooked;
+static DWORD period_frames_cached = 128;
+static DWORD last_freq = 44100;
+static BYTE *tramp_page;
+static SIZE_T tramp_used;
+
+static BOOL wchar_ieq_ascii(const WCHAR *name, SIZE_T nchars, const WCHAR *expect, SIZE_T nexpect)
+{
+    SIZE_T i;
+
+    if (nchars != nexpect) return FALSE;
+    for (i = 0; i < nexpect; i++)
+    {
+        WCHAR c = name[i];
+        if (c >= 'A' && c <= 'Z') c += 32;
+        if (c != expect[i]) return FALSE;
+    }
+    return TRUE;
+}
+
+static const WCHAR *basename_ptr(const WCHAR *path, SIZE_T nchars, SIZE_T *out_nchars)
+{
+    const WCHAR *p, *name = path;
+    SIZE_T start = 0;
+
+    for (p = path; p < path + nchars; p++)
+    {
+        if (*p == '\\' || *p == '/')
+        {
+            name = p + 1;
+            start = (SIZE_T)(p + 1 - path);
+        }
+    }
+    *out_nchars = nchars - start;
+    return name;
+}
+
+static BOOL is_osu_process(void)
+{
+    static const WCHAR osu[] = {'o','s','u','!','.','e','x','e'};
+    const UNICODE_STRING *path;
+    const WCHAR *name;
+    SIZE_T nchars, base_n;
+
+    if (!NtCurrentTeb() || !NtCurrentTeb()->Peb || !NtCurrentTeb()->Peb->ProcessParameters)
+        return FALSE;
+    path = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    if (!path->Buffer || !path->Length) return FALSE;
+    nchars = path->Length / sizeof(WCHAR);
+    name = basename_ptr(path->Buffer, nchars, &base_n);
+    return wchar_ieq_ascii(name, base_n, osu, ARRAY_LEN(osu));
+}
+
+static BOOL query_env_u(const WCHAR *key, WCHAR *buf, USHORT buf_bytes, USHORT *out_len)
+{
+    UNICODE_STRING name, value;
+    NTSTATUS st;
+
+    RtlInitUnicodeString(&name, key);
+    value.Buffer = buf;
+    value.MaximumLength = buf_bytes;
+    value.Length = 0;
+    st = RtlQueryEnvironmentVariable_U(NULL, &name, &value);
+    if (st != STATUS_SUCCESS) return FALSE;
+    if (out_len) *out_len = value.Length;
+    return TRUE;
+}
+
+static BOOL hook_enabled(void)
+{
+    WCHAR buf[8];
+    USHORT len = 0;
+
+    if (query_env_u(L"WINE_OSU_BASS_HOOK", buf, sizeof(buf), &len) && len >= sizeof(WCHAR))
+    {
+        if (buf[0] == '0') return FALSE;
+        if (buf[0] == '1') return TRUE;
+    }
+    return is_osu_process();
+}
+
+static DWORD period_frames(void)
+{
+    WCHAR buf[16];
+    USHORT len = 0;
+    DWORD v = 0, i;
+
+    if (query_env_u(L"WINE_OSU_BASS_PERIOD", buf, sizeof(buf), &len))
+    {
+        for (i = 0; i < len / sizeof(WCHAR); i++)
+        {
+            if (buf[i] < '0' || buf[i] > '9') break;
+            v = v * 10 + (DWORD)(buf[i] - '0');
+        }
+        if (v >= 16 && v <= 2048) return v;
+        WARN("ignoring WINE_OSU_BASS_PERIOD, expected 16-2048 frames\n");
+    }
+    return 128;
+}
+
+static DWORD frames_to_ms(DWORD frames, DWORD freq)
+{
+    DWORD ms;
+
+    if (!freq) freq = 44100;
+    ms = (frames * 1000 + freq / 2) / freq;
+    if (!ms) ms = 1;
+    return ms;
+}
+
+static void apply_bass_device_config(DWORD freq)
+{
+    DWORD ms;
+
+    if (!orig_BASS_SetConfig) return;
+    if (freq) last_freq = freq;
+    ms = frames_to_ms(period_frames_cached, last_freq);
+    orig_BASS_SetConfig(BASS_CONFIG_DEV_PERIOD, ms);
+    orig_BASS_SetConfig(BASS_CONFIG_DEV_BUFFER, ms * 2);
+    orig_BASS_SetConfig(BASS_CONFIG_UPDATEPERIOD, ms);
+    orig_BASS_SetConfig(BASS_CONFIG_VISTA_TRUEPOS, 1);
+    TRACE("forced DEV_PERIOD=%u ms DEV_BUFFER=%u ms (frames=%u freq=%u)\n",
+          ms, ms * 2, period_frames_cached, last_freq);
+}
+
+static DWORD WINAPI hook_BASS_SetConfig(DWORD option, DWORD value)
+{
+    DWORD ms = frames_to_ms(period_frames_cached, last_freq);
+
+    switch (option)
+    {
+    case BASS_CONFIG_DEV_PERIOD:
+        if (value > ms) value = ms;
+        break;
+    case BASS_CONFIG_DEV_BUFFER:
+        if (value > ms * 2) value = ms * 2;
+        break;
+    case BASS_CONFIG_UPDATEPERIOD:
+        if (value > ms) value = ms;
+        break;
+    case BASS_CONFIG_VISTA_TRUEPOS:
+        value = 1;
+        break;
+    }
+    return orig_BASS_SetConfig(option, value);
+}
+
+static BOOL WINAPI hook_BASS_Init(int device, DWORD freq, DWORD flags, void *win, const void *clsid)
+{
+    BOOL ok;
+
+    flags &= ~BASS_DEVICE_DSOUND;
+    flags |= BASS_DEVICE_LATENCY | BASS_DEVICE_FREQ;
+    TRACE("BASS_Init device=%d freq=%u flags=0x%lx\n", device, freq, (unsigned long)flags);
+    ok = orig_BASS_Init(device, freq, flags, win, clsid);
+    if (ok) apply_bass_device_config(freq);
+    return ok;
+}
+
+static void *find_export(HMODULE module, const char *name)
+{
+    DWORD size, i, rva;
+    const IMAGE_EXPORT_DIRECTORY *exports;
+    const DWORD *names, *funcs;
+    const WORD *ords;
+    BYTE *base = (BYTE *)module;
+
+    exports = RtlImageDirectoryEntryToData(module, TRUE, IMAGE_DIRECTORY_ENTRY_EXPORT, &size);
+    if (!exports || !exports->NumberOfNames || !exports->NumberOfFunctions) return NULL;
+    names = (const DWORD *)(base + exports->AddressOfNames);
+    ords  = (const WORD *)(base + exports->AddressOfNameOrdinals);
+    funcs = (const DWORD *)(base + exports->AddressOfFunctions);
+    for (i = 0; i < exports->NumberOfNames; i++)
+    {
+        if (strcmp((const char *)(base + names[i]), name)) continue;
+        if (ords[i] >= exports->NumberOfFunctions) return NULL;
+        rva = funcs[ords[i]];
+        /* skip forwarded exports (RVA lands inside the export directory) */
+        {
+            DWORD exp_rva = (DWORD)((BYTE *)exports - base);
+            if (rva >= exp_rva && rva < exp_rva + size) return NULL;
+        }
+        if (!rva) return NULL;
+        return base + rva;
+    }
+    return NULL;
+}
+
+#ifdef _WIN64
+static void write_jmp(BYTE *dst, void *to)
+{
+    dst[0] = 0x48; /* mov rax, imm64 */
+    dst[1] = 0xb8;
+    memcpy(dst + 2, &to, sizeof(to));
+    dst[10] = 0xff; /* jmp rax */
+    dst[11] = 0xe0;
+}
+#else
+static void write_jmp(BYTE *dst, void *to)
+{
+    INT32 rel = (INT32)((char *)to - ((char *)dst + 5));
+    dst[0] = 0xe9;
+    memcpy(dst + 1, &rel, sizeof(rel));
+}
+#endif
+
+static BYTE *alloc_trampoline(void)
+{
+    SIZE_T page = 0x1000;
+    NTSTATUS st;
+    void *addr;
+    BYTE *slot;
+
+    if (!tramp_page)
+    {
+        addr = NULL;
+        st = NtAllocateVirtualMemory(NtCurrentProcess(), &addr, 0, &page,
+                                     MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
+        if (st)
+        {
+            WARN("NtAllocateVirtualMemory trampoline page failed %#lx\n", st);
+            return NULL;
+        }
+        tramp_page = addr;
+        tramp_used = 0;
+    }
+    if (tramp_used + 32 > 0x1000) return NULL;
+    slot = tramp_page + tramp_used;
+    tramp_used += 32;
+    return slot;
+}
+
+static BOOL install_inline_hook(void *target, void *hook, void **orig)
+{
+    BYTE *tramp;
+    SIZE_T size;
+    ULONG old_prot, dummy;
+    void *addr;
+    NTSTATUS st;
+
+    if (!target || !hook || !orig) return FALSE;
+    tramp = alloc_trampoline();
+    if (!tramp) return FALSE;
+
+    memcpy(tramp, target, JMP_LEN);
+    write_jmp(tramp + JMP_LEN, (char *)target + JMP_LEN);
+    NtFlushInstructionCache(NtCurrentProcess(), tramp, 32);
+
+    addr = target;
+    size = JMP_LEN;
+    st = NtProtectVirtualMemory(NtCurrentProcess(), &addr, &size, PAGE_EXECUTE_READWRITE, &old_prot);
+    if (st)
+    {
+        WARN("NtProtectVirtualMemory target failed %#lx\n", st);
+        return FALSE;
+    }
+    write_jmp(target, hook);
+    NtProtectVirtualMemory(NtCurrentProcess(), &addr, &size, old_prot, &dummy);
+    NtFlushInstructionCache(NtCurrentProcess(), target, JMP_LEN);
+
+    *orig = tramp;
+    return TRUE;
+}
+
+static void hook_bass_module(HMODULE module, const UNICODE_STRING *basename)
+{
+    void *p_init, *p_set;
+
+    if (hooked) return;
+    p_init = find_export(module, "BASS_Init");
+    p_set  = find_export(module, "BASS_SetConfig");
+    if (!p_init || !p_set)
+    {
+        WARN("bass exports missing on %s\n", debugstr_us(basename));
+        return;
+    }
+    /* SetConfig first: osu may call it before BASS_Init. */
+    if (!install_inline_hook(p_set, hook_BASS_SetConfig, (void **)&orig_BASS_SetConfig))
+        return;
+    if (!install_inline_hook(p_init, hook_BASS_Init, (void **)&orig_BASS_Init))
+    {
+        WARN("BASS_Init hook failed; SetConfig hook is live\n");
+        hooked = TRUE;
+        return;
+    }
+    hooked = TRUE;
+    TRACE("hooked BASS in %s\n", debugstr_us(basename));
+}
+
+static BOOL basename_is_bass(const UNICODE_STRING *name)
+{
+    static const WCHAR bass[] = {'b','a','s','s','.','d','l','l'};
+    const WCHAR *base;
+    SIZE_T nchars, base_n;
+
+    if (!name || !name->Buffer || !name->Length) return FALSE;
+    nchars = name->Length / sizeof(WCHAR);
+    base = basename_ptr(name->Buffer, nchars, &base_n);
+    return wchar_ieq_ascii(base, base_n, bass, ARRAY_LEN(bass));
+}
+
+static void CALLBACK bass_ldr_notify(ULONG reason, LDR_DLL_NOTIFICATION_DATA *data, void *context)
+{
+    const LDR_DLL_LOADED_NOTIFICATION_DATA *loaded;
+
+    if (reason != LDR_DLL_NOTIFICATION_REASON_LOADED || !data) return;
+    loaded = &data->Loaded;
+    if (!loaded->BaseDllName || !basename_is_bass(loaded->BaseDllName)) return;
+    hook_bass_module(loaded->DllBase, loaded->BaseDllName);
+}
+
+static void CALLBACK enum_loaded(LDR_DATA_TABLE_ENTRY *mod, void *context, BOOLEAN *stop)
+{
+    if (basename_is_bass(&mod->BaseDllName))
+        hook_bass_module(mod->DllBase, &mod->BaseDllName);
+}
+
+void osu_bass_init(void)
+{
+    void *cookie;
+
+    if (!hook_enabled())
+    {
+        TRACE("disabled\n");
+        return;
+    }
+    period_frames_cached = period_frames();
+    if (LdrRegisterDllNotification(0, bass_ldr_notify, NULL, &cookie) != STATUS_SUCCESS)
+        WARN("LdrRegisterDllNotification failed\n");
+    /* bass.dll is normally loaded after ntdll; this covers an already-mapped copy. */
+    LdrEnumerateLoadedModules(NULL, enum_loaded, NULL);
+    TRACE("watching for bass.dll (period=%u frames)\n", period_frames_cached);
+}
